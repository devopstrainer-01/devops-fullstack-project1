# Copy to `.env` ON THE APP EC2 ONLY. Never commit the real file (it's gitignored).
# Jenkins does not template this file — it is created once by hand during
# server setup and stays on the instance. See deployment-docs/08-secrets-management.md

# -- Database (self-hosted Postgres on its own EC2) --
DB_HOST=10.0.0.X          # private IP of the DB EC2, never the public one
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me

APP_ENV=production

# -- Images pulled by docker-compose.yml --
# Filled in / overridden by the deploy step with the tag Jenkins just built.
BACKEND_IMAGE=ghcr.io/OWNER/devops-fullstack-project1-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/devops-fullstack-project1-frontend:latest
