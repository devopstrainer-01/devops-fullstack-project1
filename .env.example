# Template only — never commit the real file (it's gitignored anyway).
#
# The DB_* / APP_ENV lines below are what you upload as the Jenkins
# "Secret file" credential `app-env-file`. The Jenkinsfile's deploy stage
# writes that file to .env on the App EC2 on every deploy, then appends the
# two *_IMAGE lines itself with the tag it just built. You never create a
# real .env by hand on the server for day-to-day deploys — see
# deployment-docs/08-secrets-management.md.

# -- Database (self-hosted Postgres on its own EC2) --
DB_HOST=10.0.0.X          # private IP of the DB EC2, never the public one
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me

APP_ENV=production

# -- Images pulled by docker-compose.yml --
# NOT part of the app-env-file credential — Jenkins appends these two lines
# itself after writing the rest of .env. Shown here only so the file's full
# shape is clear.
BACKEND_IMAGE=ghcr.io/OWNER/devops-fullstack-project1-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/devops-fullstack-project1-frontend:latest
